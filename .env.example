# Copy to .env.local (gitignored). Never commit real keys.
PORT=4317
# Owner admin password for /admin (default if unset: sooke-tides — change it!)
ADMIN_PASSWORD=
# Stripe TEST keys only (sk_test_... / pk_test_...). Live keys are refused; checkout falls back to demo mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional: webhook signing secret for /api/stripe/webhook (checkout.session.completed, payment_intent.succeeded)
STRIPE_WEBHOOK_SECRET=
# Optional: public base URL used for Stripe success/cancel redirects (auto-detected otherwise)
PUBLIC_URL=
# Optional: comma-separated origins allowed to call the public JSON API (default *)
CORS_ORIGINS=*
# Optional: where site.json + uploads live (point at a persistent disk in production)
DATA_DIR=
